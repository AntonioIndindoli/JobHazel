{
  "manifest_version": 3,
  "name": "JobHazel",
  "version": "0.1.0",
  "description": "Capture a job posting and review it in JobHazel.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": {
    "default_title": "Save job to JobHazel",
    "default_icon": { "16": "icons/icon.png", "32": "icons/icon.png" }
  },
  "icons": { "16": "icons/icon.png", "48": "icons/icon.png", "128": "icons/icon.png" },
  "externally_connectable": { "matches": ["https://jobhazel.com/*"] }
}
