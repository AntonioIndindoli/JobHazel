DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55489/jobappledger"
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@127.0.0.1:55489/jobappledger"
# Must belong to the same Neon branch as DATABASE_URL.
NEON_AUTH_BASE_URL="https://your-endpoint.neonauth.your-region.aws.neon.tech/neondb/auth"
AUTH_RATE_LIMIT_SECRET="replace-with-long-random-secret"
PORT="4000"
# Production: https://jobhazel.com
# Comma-separated when more than one browser origin should be allowed.
CORS_ORIGIN="http://localhost:3000"
# Comma-separated Chrome extension origins allowed to call the API.
EXTENSION_ORIGINS="chrome-extension://nlbcijcaamjlllibnbkgmbeniaiagdkl"
# Production: true
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
APP_URL="http://localhost:3000"
# App notification email; Neon Auth owns verification and password-recovery email.
RESEND_API_KEY=""
EMAIL_FROM="JobHazel <accounts@jobhazel.com>"

# Reminder delivery: use the public backend origin and a separate random signing secret.
API_PUBLIC_URL="http://localhost:4000"
NOTIFICATION_UNSUBSCRIBE_SECRET=""
# Vercel sends this as the cron request's bearer token. Required for scheduled delivery.
CRON_SECRET=""

# Private Cloudflare R2 resume storage. Required in production; if one R2 value
# is set in development, all five must be provided.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="jobhazel-resumes"
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
RESUME_UPLOAD_MAX_BYTES="5242880"
RESUME_ACTIVE_LIMIT="10"
RESUME_SIGNED_URL_TTL_SECONDS="300"

# Authenticated maintenance and database-backed endpoint rate limits. Vercel Cron
# can use CRON_SECRET instead of RESUME_CLEANUP_SECRET.
RESUME_CLEANUP_SECRET="replace-with-long-random-secret"
RESUME_CLEANUP_STALE_HOURS="24"
RESUME_CLEANUP_BATCH_SIZE="100"
RESUME_RATE_LIMIT_WINDOW_SECONDS="900"
RESUME_UPLOAD_INIT_RATE_LIMIT="10"
RESUME_UPLOAD_COMPLETE_RATE_LIMIT="20"
RESUME_DOWNLOAD_RATE_LIMIT="60"

# Optional seed overrides
SEED_USER_EMAIL="demo@jobappledger.local"
SEED_USER_PASSWORD="DemoPass123!"
SEED_USER_NAME="Demo User"
