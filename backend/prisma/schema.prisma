generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ContactRelationship {
  RECRUITER
  REFERRAL
  HIRING_MANAGER
  EMPLOYEE
  OTHER
}

enum InterviewType {
  RECRUITER_SCREEN
  TECHNICAL
  MANAGER
  PANEL
  FINAL
  TAKE_HOME
  OTHER
}

enum InterviewOutcome {
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
  CANCELED
}

enum TaskType {
  FOLLOW_UP
  PREP
  THANK_YOU
  REMINDER
  OTHER
}

enum ActivityType {
  APPLICATION_CREATED
  STATUS_CHANGED
  APPLICATION_UPDATED
  INTERVIEW_ADDED
  INTERVIEW_UPDATED
  TASK_ADDED
  TASK_COMPLETED
  NOTE_ADDED
  IMPORT_CONVERTED
  RESUME_ATTACHED
  RESUME_CHANGED
  RESUME_REMOVED
}

enum ResumeUploadStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                      String          @id @default(cuid())
  name                    String?
  email                   String          @unique
  passwordHash            String?
  neonAuthId              String?         @unique @db.Uuid
  applications            Application[]
  companies               Company[]
  contacts                Contact[]
  interviews              Interview[]
  tasks                   Task[]
  autoCreateFollowUpTasks Boolean         @default(false)
  autoCreateThankYouTasks Boolean         @default(false)
  followUpTaskDelayDays   Int             @default(7)
  thankYouTaskDelayDays   Int             @default(1)
  resumeVersions          ResumeVersion[]
  importDrafts            ImportDraft[]
  activityLogs            ActivityLog[]
  refreshTokens           RefreshToken[]
  authTokens              AuthToken[]
  emailVerifiedAt         DateTime?
  resumeEndpointRateLimits ResumeEndpointRateLimit[]
  notificationPreference  NotificationPreference?
  notificationDeliveries  NotificationDelivery[]
  notificationOperations NotificationOperation[]
  notificationSync       NotificationSync?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String           @unique
  email     String?
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  size         String?
  logoUrl      String?
  notes        String?
  applications Application[]
  contacts     Contact[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title           String
  status          ApplicationStatus @default(SAVED)
  source          String?
  sourceUrl       String?
  location        String?
  workplaceType   WorkplaceType?
  employmentType  EmploymentType?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  description     String?
  priority        Priority          @default(MEDIUM)
  dateSaved       DateTime          @default(now())
  dateApplied     DateTime?
  resumeVersionId String?
  resumeVersion   ResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  notes           String?
  contacts        Contact[]
  interviews      Interview[]
  tasks           Task[]
  automatedFollowUp Task? @relation("FollowUpSource")
  activityLogs    ActivityLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, sourceUrl])
  @@index([userId, status])
  @@index([companyId])
}

model Contact {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name          String
  role          String?
  email         String?
  linkedinUrl   String?
  relationship  ContactRelationship @default(OTHER)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, name])
  @@index([companyId])
  @@index([applicationId])
}

model Interview {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type            InterviewType
  scheduledAt     DateTime
  durationMinutes Int?
  location        String?
  meetingUrl      String?
  interviewerName String?
  notes           String?
  outcome         InterviewOutcome @default(SCHEDULED)
  thankYouTask     Task? @relation("ThankYouSource")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, scheduledAt])
  @@index([applicationId, scheduledAt])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  sourceApplicationId String? @unique
  sourceApplication Application? @relation("FollowUpSource", fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  sourceInterviewId String? @unique
  sourceInterview Interview? @relation("ThankYouSource", fields: [sourceInterviewId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  dueDate       DateTime?
  completedAt   DateTime?
  type          TaskType     @default(OTHER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, dueDate])
  @@index([applicationId])
}

model ResumeVersion {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  targetRole       String?
  storageKey       String             @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  uploadStatus     ResumeUploadStatus @default(PENDING)
  extractedText    String?
  notes            String?
  archivedAt       DateTime?
  applications     Application[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([userId, checksum])
  @@index([userId, archivedAt])
  @@index([uploadStatus, updatedAt])
}

model ResumeEndpointRateLimit {
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint        String
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@id([userId, endpoint])
  @@index([windowStartedAt])
}

model ResumeCleanupRun {
  id               String    @id @default(cuid())
  status           String
  scannedCount     Int       @default(0)
  deletedCount     Int       @default(0)
  failedCount      Int       @default(0)
  skippedCount     Int       @default(0)
  reclaimedBytes   BigInt    @default(0)
  failureResumeIds Json?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([startedAt])
}

model ImportDraft {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  captureId         String?
  sourceUrl         String?
  sourceDomain      String?
  pageTitle         String?
  rawText           String?
  parsedTitle       String?
  parsedCompany     String?
  parsedLocation    String?
  parsedSalaryMin   Int?
  parsedSalaryMax   Int?
  parsedDescription String?
  confidence        Float?
  createdAt         DateTime  @default(now())
  convertedAt       DateTime?

  @@index([userId, createdAt])
  @@unique([userId, captureId])
}

model ActivityLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  message       String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
}

model AuthRateLimit {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model NotificationPreference {
  userId                   String   @id
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled             Boolean  @default(false)
  upcomingTasks            Boolean  @default(true)
  overdueTasks             Boolean  @default(true)
  interviewReminders       Boolean  @default(true)
  taskReminderDays          Int      @default(1)
  interviewReminderMinutes Int      @default(60)
  timeZone                 String   @default("UTC")
  quietHoursEnabled        Boolean  @default(false)
  quietHoursStart           String   @default("22:00")
  quietHoursEnd             String   @default("08:00")
  updatedAt                DateTime @updatedAt
}

enum NotificationKind {
  TASK_DIGEST
  UPCOMING_TASK
  OVERDUE_TASK
  INTERVIEW_REMINDER
}

// This ledger is independent of the legacy delivery worker. Rows survive deletion
// as cancellation tombstones; recipient/payload data is cleared before deletion.
model NotificationOperation {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind            NotificationKind
  resourceId      String?
  familyKey       String
  revision        String
  digestKey       String?  @unique
  desired         Boolean  @default(true)
  status          String   @default("PENDING")
  sendAt          DateTime
  expiresAt       DateTime
  eventAt         DateTime
  payload         Json?
  providerId      String?  @unique
  firstAttemptAt  DateTime?
  attempts        Int      @default(0)
  nextAttemptAt   DateTime @default(now())
  leaseToken      String?
  leaseUntil      DateTime?
  providerEvent   String?
  providerEventAt DateTime?
  sentAt          DateTime?
  deliveredAt     DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, kind, resourceId])
  @@index([desired, status, nextAttemptAt])
  @@index([familyKey, createdAt])
}

model NotificationSync {
  userId    String @id
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  revision  Int    @default(1)
  cursor    String?
  updatedAt DateTime @updatedAt
}

model NotificationRun {
  id          String @id
  cursor      String?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Store only event identity and delivery outcome, never the raw recipient payload.
model NotificationProviderEvent {
  id         String @id
  providerId String
  type       String
  eventAt    DateTime
  createdAt  DateTime @default(now())
  @@index([providerId, eventAt])
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  CANCELED
  FAILED
  UNKNOWN
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  userId         String
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           NotificationKind
  resourceId     String
  eventAt        DateTime
  dedupeKey      String                     @unique
  status         NotificationDeliveryStatus @default(PENDING)
  nextAttemptAt  DateTime                   @default(now())
  leaseUntil     DateTime?
  leaseToken     String?
  attempts       Int                        @default(0)
  firstAttemptAt DateTime?
  payload        Json?
  providerId     String?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, leaseUntil])
  @@index([userId, createdAt])
}
