generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum WorkplaceType {
  ONSITE
  HYBRID
  REMOTE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  FREELANCE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ContactRelationship {
  RECRUITER
  REFERRAL
  HIRING_MANAGER
  EMPLOYEE
  OTHER
}

enum InterviewType {
  RECRUITER_SCREEN
  TECHNICAL
  MANAGER
  PANEL
  FINAL
  TAKE_HOME
  OTHER
}

enum InterviewOutcome {
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
  CANCELED
}

enum TaskType {
  FOLLOW_UP
  PREP
  THANK_YOU
  REMINDER
  OTHER
}

enum ActivityType {
  APPLICATION_CREATED
  STATUS_CHANGED
  APPLICATION_UPDATED
  INTERVIEW_ADDED
  INTERVIEW_UPDATED
  TASK_ADDED
  TASK_COMPLETED
  NOTE_ADDED
  IMPORT_CONVERTED
  RESUME_ATTACHED
  RESUME_CHANGED
  RESUME_REMOVED
}

enum ResumeUploadStatus {
  PENDING
  READY
  FAILED
}

model User {
  id                      String          @id @default(cuid())
  name                    String?
  email                   String          @unique
  passwordHash            String
  applications            Application[]
  companies               Company[]
  contacts                Contact[]
  interviews              Interview[]
  tasks                   Task[]
  autoCreateFollowUpTasks Boolean         @default(false)
  autoCreateThankYouTasks Boolean         @default(false)
  followUpTaskDelayDays   Int             @default(7)
  thankYouTaskDelayDays   Int             @default(1)
  resumeVersions          ResumeVersion[]
  importDrafts            ImportDraft[]
  activityLogs            ActivityLog[]
  refreshTokens           RefreshToken[]
  resumeEndpointRateLimits ResumeEndpointRateLimit[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  website      String?
  industry     String?
  size         String?
  logoUrl      String?
  notes        String?
  applications Application[]
  contacts     Contact[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
}

model Application {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  title           String
  status          ApplicationStatus @default(SAVED)
  source          String?
  sourceUrl       String?
  location        String?
  workplaceType   WorkplaceType?
  employmentType  EmploymentType?
  salaryMin       Int?
  salaryMax       Int?
  currency        String?
  description     String?
  priority        Priority          @default(MEDIUM)
  dateSaved       DateTime          @default(now())
  dateApplied     DateTime?
  resumeVersionId String?
  resumeVersion   ResumeVersion?    @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
  notes           String?
  contacts        Contact[]
  interviews      Interview[]
  tasks           Task[]
  activityLogs    ActivityLog[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, sourceUrl])
  @@index([userId, status])
  @@index([companyId])
}

model Contact {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId     String?
  company       Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application?        @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  name          String
  role          String?
  email         String?
  linkedinUrl   String?
  relationship  ContactRelationship @default(OTHER)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([userId, name])
  @@index([companyId])
  @@index([applicationId])
}

model Interview {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type            InterviewType
  scheduledAt     DateTime
  durationMinutes Int?
  location        String?
  meetingUrl      String?
  interviewerName String?
  notes           String?
  outcome         InterviewOutcome @default(SCHEDULED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([userId, scheduledAt])
  @@index([applicationId, scheduledAt])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  title         String
  description   String?
  dueDate       DateTime?
  completedAt   DateTime?
  type          TaskType     @default(OTHER)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([userId, dueDate])
  @@index([applicationId])
}

model ResumeVersion {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  targetRole       String?
  storageKey       String             @unique
  originalFilename String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  uploadStatus     ResumeUploadStatus @default(PENDING)
  extractedText    String?
  notes            String?
  archivedAt       DateTime?
  applications     Application[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([userId, checksum])
  @@index([userId, archivedAt])
  @@index([uploadStatus, updatedAt])
}

model ResumeEndpointRateLimit {
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint        String
  windowStartedAt DateTime
  requestCount    Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@id([userId, endpoint])
  @@index([windowStartedAt])
}

model ResumeCleanupRun {
  id               String    @id @default(cuid())
  status           String
  scannedCount     Int       @default(0)
  deletedCount     Int       @default(0)
  failedCount      Int       @default(0)
  skippedCount     Int       @default(0)
  reclaimedBytes   BigInt    @default(0)
  failureResumeIds Json?
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([startedAt])
}

model ImportDraft {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  captureId         String?
  sourceUrl         String?
  sourceDomain      String?
  pageTitle         String?
  rawText           String?
  parsedTitle       String?
  parsedCompany     String?
  parsedLocation    String?
  parsedSalaryMin   Int?
  parsedSalaryMax   Int?
  parsedDescription String?
  confidence        Float?
  createdAt         DateTime  @default(now())
  convertedAt       DateTime?

  @@index([userId, createdAt])
  @@unique([userId, captureId])
}

model ActivityLog {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          ActivityType
  message       String
  metadata      Json?
  createdAt     DateTime     @default(now())

  @@index([applicationId, createdAt])
  @@index([userId, createdAt])
}
